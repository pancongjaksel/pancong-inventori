# Salin file ini jadi .env dan isi nilai aslinya. JANGAN commit file .env ke git.

# --- Database ---
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/pancong_inventori
PGHOST=localhost
PGPORT=5432
PGDATABASE=pancong_inventori
PGUSER=postgres
PGPASSWORD=

# --- Auth (login email + password) ---
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- QR Setup Device ---
# Generate dengan cara yang sama kayak JWT_SECRET, tapi pakai nilai BEDA
DEVICE_QR_SECRET=

# --- App ---
APP_BASE_URL=https://app.pancongjaksel.com
# Boleh lebih dari satu, dipisah koma (Vite kadang pindah port kalau 5173 lagi kepakai)
FRONTEND_URL=http://localhost:5173,http://localhost:5174
NODE_ENV=development
PORT=3000
