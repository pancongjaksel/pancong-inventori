# Salin jadi .env.test — database TERPISAH dari yang dipakai operasional
# harian, biar test gak numpuk/ngerusak data asli. Bikin database baru
# khusus buat ini dulu:
#   CREATE DATABASE pancong_inventori_test;
# Terus jalanin migration ke situ: PGDATABASE=pancong_inventori_test npm run migrate:up

DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/pancong_inventori_test
PGHOST=localhost
PGPORT=5432
PGDATABASE=pancong_inventori_test
PGUSER=postgres
PGPASSWORD=

JWT_SECRET=secret-khusus-testing-jangan-dipakai-production
DEVICE_QR_SECRET=secret-khusus-testing-jangan-dipakai-production
APP_BASE_URL=http://localhost:5174
FRONTEND_URL=http://localhost:5173,http://localhost:5174
NODE_ENV=test
PORT=3001
